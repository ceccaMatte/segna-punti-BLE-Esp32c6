menu "Playmaker wearable"

config WEARABLE_BUTTON_A_GPIO
    int "Physical A button GPIO"
    default 3
config WEARABLE_BUTTON_B_GPIO
    int "Physical B button GPIO"
    default 1
config WEARABLE_BUTTON_MOMENT_GPIO
    int "Physical Moment button GPIO"
    default 0
config WEARABLE_BUTTON_UNDO_GPIO
    int "Physical Undo button GPIO"
    default 5
config WEARABLE_BUTTON_ACTIVE_LOW
    bool "Buttons are active low"
    default y

config WEARABLE_BUZZER_GPIO
    int "Passive buzzer GPIO"
    default 20

config WEARABLE_CHARGE_LED_GPIO
    int "Charge status LED GPIO (-1 disables)"
    default -1

config WEARABLE_CHARGER_STAT_ADC_CHANNEL
    int "ADC1 channel connected to MCP73831 STAT divider"
    range 0 4
    default 4
    help
        PCB: MCP73831 STAT -> 100k -> battery_state -> 100k -> GND,
        battery_state -> ESP32-C3 GPIO4 / ADC1_CH4.

config WEARABLE_CHARGER_STAT_HIGH_RAW
    int "ADC raw threshold: STAT HIGH / charge complete"
    range 1 4094
    default 1000
    help
        STAT is approximately 0 V while charging and approximately 2.5 V at
        battery_state when MCP73831 drives STAT HIGH. The large voltage gap
        makes a conservative raw ADC threshold sufficient; exact voltage
        calibration is not required for this state decision.

config WEARABLE_VBUS_SENSE_GPIO
    int "5V/VBUS-present GPIO (-1 if unavailable)"
    default -1
    help
        Needed to distinguish MCP73831 STAT LOW (charging) from STAT High-Z
        (charger unpowered). With only the current STAT divider those two
        conditions both pull battery_state near 0 V.

config WEARABLE_VBUS_SENSE_ACTIVE_HIGH
    bool "VBUS sense is active high"
    default y

config WEARABLE_BATTERY_VOLTAGE_ADC_CHANNEL
    int "ADC1 channel for a dedicated Vbat divider (-1 if unavailable)"
    range -1 4
    default -1
    help
        The current PCB does not expose Vbat through a dedicated ADC divider.
        Leave disabled. It is required for a true low-battery voltage alarm.

config WEARABLE_BATTERY_DIVIDER_NUM
    int "Vbat divider numerator"
    default 1
config WEARABLE_BATTERY_DIVIDER_DEN
    int "Vbat divider denominator"
    default 1
config WEARABLE_LOW_BATTERY_MV
    int "Low battery threshold (mV)"
    default 3300
config WEARABLE_LOW_BATTERY_BEEP_MS
    int "Low battery reminder period (ms)"
    default 20000

config WEARABLE_PAIRING_WINDOW_MS
    int "Pairing window (ms)"
    default 120000

endmenu
