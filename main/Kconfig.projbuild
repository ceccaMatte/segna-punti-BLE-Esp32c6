menu "Playmaker wearable"

config WEARABLE_BUTTON_1_GPIO
    int "Button 1 GPIO"
    default 4
config WEARABLE_BUTTON_2_GPIO
    int "Button 2 GPIO"
    default 5
config WEARABLE_BUTTON_3_GPIO
    int "Button 3 GPIO"
    default 6
config WEARABLE_BUTTON_4_GPIO
    int "Button 4 GPIO"
    default 7
config WEARABLE_BUTTON_ACTIVE_LOW
    bool "Buttons are active low"
    default y

config WEARABLE_BUZZER_GPIO
    int "Passive buzzer GPIO"
    default 10

config WEARABLE_CHARGE_LED_GPIO
    int "Charge status LED GPIO (-1 disables)"
    default -1
config WEARABLE_CHARGING_GPIO
    int "Charger CHRG/status input GPIO (-1 disables)"
    default -1
config WEARABLE_CHARGING_ACTIVE_LOW
    bool "Charger status input is active low"
    default y
config WEARABLE_POWER_PRESENT_GPIO
    int "USB/power-present input GPIO (-1 if unavailable)"
    default -1
config WEARABLE_POWER_PRESENT_ACTIVE_HIGH
    bool "Power-present input is active high"
    default y

config WEARABLE_BATTERY_ADC_CHANNEL
    int "ADC1 channel for battery divider (-1 disables)"
    range -1 4
    default -1
config WEARABLE_BATTERY_DIVIDER_NUM
    int "Battery divider numerator"
    default 2
config WEARABLE_BATTERY_DIVIDER_DEN
    int "Battery divider denominator"
    default 1
config WEARABLE_LOW_BATTERY_MV
    int "Low battery threshold (mV)"
    default 3300
config WEARABLE_LOW_BATTERY_BEEP_MS
    int "Low battery reminder period (ms)"
    default 20000

config WEARABLE_PAIRING_WINDOW_MS
    int "Pairing window (ms)"
    default 120000

endmenu
