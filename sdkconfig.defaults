# Configurazione predefinita per il segnapunti padel
# su Waveshare ESP32-C6-LCD-1.47.
#
# SPDX-License-Identifier: MIT

# --- Target ---------------------------------------------------------------
# Permette di compilare da un albero pulito senza eseguire prima
# "idf.py set-target".
CONFIG_IDF_TARGET="esp32c6"
CONFIG_IDF_TARGET_ESP32C6=y

# --- Console --------------------------------------------------------------
# La scheda NON ha nessun convertitore USB-seriale. Il connettore USB-C va
# dritto nel controllo USB Serial/JTAG del chip, quindi quella e' l'unica porta
# che un monitor seriale possa usare.
#
# Di suo ESP-IDF manda la console principale sull'UART0 e si limita a copiarla
# sul USB Serial/JTAG senza bloccarsi. Scegliendo quest'ultimo come console
# principale si ottiene una scrittura che aspetta di essere letta, e quindi un
# monitor che funziona davvero.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Flash ----------------------------------------------------------------
# 4 MB di memoria flash, capace di quattro linee ma pilotata a due dal
# produttore.
CONFIG_ESPTOOLPY_FLASHMODE="dio"
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_STR=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# --- Sistema --------------------------------------------------------------
# Il battito del sistema scende da 10 a 1 millisecondo. Serve al ciclo
# principale, che gira ogni 5 millisecondi per riconoscere i click multipli:
# con il battito a 10 millisecondi una pausa di 5 verrebbe arrotondata a zero.
CONFIG_FREERTOS_HZ=1000

# Il ciclo principale non fa quasi niente, ma legge il pulsante e ogni tanto
# ridisegna. Lo spazio predefinito e' un po' stretto.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
