# Playmaker wearable - ESP32-C3 / ESP-IDF
CONFIG_IDF_TARGET="esp32c3"
CONFIG_IDF_TARGET_ESP32C3=y

# Flying prototype: GPIO20 is reserved as input and GPIO21 is held LOW.
# Keep the console on the native USB Serial/JTAG interface so UART0 pins are
# not needed for logging. The unmounted buzzer is reserved on GPIO5.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Wi-Fi LAN transport: no Bluetooth controller or NimBLE host.
CONFIG_BT_ENABLED=n

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_NVS_ENCRYPTION=n


# The Wi-Fi/HTTP configuration UI pushes the firmware beyond the ESP-IDF
# default 1 MiB factory partition. ESP32-C3 SuperMini uses 4 MiB flash.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
